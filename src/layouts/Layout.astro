---
import "../styles/global.css";
import LogoHorizontal from "../assets/brand/logo-horizontal.svg";
import { SITE_TITLE } from "astro:env/client";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import GitHubLink from "../components/GitHubLink.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import NavLinks from "../components/NavLinks.astro";
import Search from "../components/Search.astro";
import BaseHead, { type Props as BaseHeadProps } from "../components/BaseHead.astro";
import ThemePicker from "../components/ThemePicker.astro";
import themes from "../data/themes.json";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "../i18n/utils";

type Props = BaseHeadProps;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...Astro.props} />
    <script is:inline define:vars={{ themes }}>
      const root = document.documentElement;
      const today = new Date();
      const monthDay = `${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
      const inSeason = ({ from, to }) => (from <= to ? monthDay >= from && monthDay <= to : monthDay >= from || monthDay <= to);
      const seasonal = themes.find((theme) => theme.season && inSeason(theme.season));
      const available = themes.filter((theme) => !theme.season || theme === seasonal).map((theme) => theme.id);
      const theme = localStorage.getItem("theme");

      if (seasonal) {
        const { from, to } = seasonal.season;
        const startYear = from > to && monthDay <= to ? today.getFullYear() - 1 : today.getFullYear();
        root.dataset.season = `${seasonal.id}:${startYear}`;
      } else {
        localStorage.removeItem("themeSeason");
      }

      if (seasonal && localStorage.getItem("themeSeason") !== root.dataset.season) root.dataset.theme = seasonal.id;
      else if (available.includes(theme)) root.dataset.theme = theme;
      else localStorage.removeItem("theme");
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="author" href="/humans.txt" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div class="drawer">
      <input
        id="my-drawer-2"
        type="checkbox"
        aria-label={t("nav.menu")}
        class="drawer-toggle lg:hidden"
      />
      <div class="drawer-content flex min-h-dvh flex-col">
        <!-- Navbar -->
        <header class="navbar bg-base-300 sticky top-0 z-10 w-full md:px-8" transition:animate="none">
          <div class="flex-none lg:hidden">
            <label for="my-drawer-2" class="btn btn-square btn-ghost drawer-button">
              <span class="sr-only">{t("nav.openMenu")}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="inline-block h-6 w-6 stroke-current"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </label>
          </div>
          <div class="mx-2 flex-1 px-2">
            <a href={translatePath("/")} aria-label={SITE_TITLE} class="inline-flex">
              <LogoHorizontal class="h-9 w-auto sm:h-10" aria-hidden="true" />
            </a>
          </div>
          <div class="flex flex-none items-center gap-1 lg:gap-4">
            <Search />
            <div class="hidden items-center gap-4 lg:flex">
              <nav aria-label={t("nav.main")}>
                <ul class="menu menu-horizontal gap-2 p-0">
                  <NavLinks />
                </ul>
              </nav>
              <div class="bg-base-content/15 h-6 w-px" aria-hidden="true"></div>
              <div class="flex items-center gap-2">
                <LanguagePicker />
                <ThemePicker name="theme-navbar" />
              </div>
            </div>
            <GitHubLink />
          </div>
        </header>
        <!-- Page content here -->
        <slot />
        <Footer />
      </div>
      <div class="drawer-side">
        <label for="my-drawer-2" class="drawer-overlay">
          <span class="sr-only">{t("nav.closeMenu")}</span>
        </label>
        <div class="flex min-h-full w-80 max-w-[85vw] flex-col gap-4 bg-base-200 p-4">
          <a href={translatePath("/")} aria-label={SITE_TITLE} class="inline-flex px-2 py-1">
            <LogoHorizontal class="h-9 w-auto" aria-hidden="true" />
          </a>
          <nav aria-label={t("nav.main")}>
            <ul class="menu w-full gap-1 p-0">
              <NavLinks />
            </ul>
          </nav>
          <div class="border-base-content/10 flex flex-col gap-2 border-t pt-4">
            <LanguagePicker block />
            <ThemePicker name="theme-drawer" block />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

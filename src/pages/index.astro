---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const states = await getCollection('states');
---

<Layout>
	<h1 class="text-3xl font-bold underline">
		Estados
	</h1>

	<ul>
		{states.map(state => (
			<li>{state.data.name}</li>
		))}
	</ul>

</Layout>

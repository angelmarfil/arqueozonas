---
import Layout from '../../../layouts/Layout.astro';
import { SEO } from 'astro-seo';
import { SITE_TITLE, TITLE_DELIMITER } from 'astro:env/client';
import PageHeader from '../../../components/PageHeader.astro';
import ImageLicense from '../../../components/ImageLicense.astro';
import LinkCard from '../../../components/LinkCard.astro';
import { getSites, getStateCover, getStates } from '../../../i18n/content';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const states = await getStates();
const covers = await Promise.all(states.map(getStateCover));
const sites = await getSites(lang);
const siteCount = (stateId: string) =>
	sites.filter((site) => site.data.state === stateId).length;
---

<Layout>
	<SEO
		slot="head"
		charset="utf-8"
		title={t('nav.sites')}
		description={t('seo.sites.description')}
		titleTemplate={`%s ${TITLE_DELIMITER} ${SITE_TITLE}`}
		extend={{
			meta: [
				{
					name: "viewport",
					content: "width=device-width",
				},
				{
					name: "generator",
					content: Astro.generator,
				},
				{
					name: "apple-mobile-web-app-title",
					content: "Arqueozonas MX",
				},
			],
			link: [
				{
					rel: "icon",
					type: "image/png",
					href: "/favicon/favicon-96x96.png",
					sizes: "96x96",
				},
				{
					rel: "icon",
					type: "image/svg+xml",
					href: "/favicon/favicon.svg",
				},
				{
					rel: "shortcut icon",
					href: "/favicon/favicon.ico",
				},
				{
					rel: "apple-touch-icon",
					sizes: "180x180",
					href: "/favicon/apple-touch-icon.png",
				},
				{
					rel: "manifest",
					href: "/site.webmanifest",
				},
			],
		}}
	/>

	<main class="mx-auto w-full max-w-7xl px-4 py-6 sm:py-10 md:px-8">
		<PageHeader
			class="mb-6 sm:mb-8"
			title={t('nav.sites')}
			crumbs={[{ label: t('nav.sites'), icon: 'boxicons:pyramid-filled' }]}
		>
			<p class="text-base-content/70">{t('seo.sites.description')}</p>
		</PageHeader>

		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{
				states.map((state, i) => {
					const count = siteCount(state.id);
					return (
						<LinkCard
							href={translatePath(`/zonas-arqueologicas/${state.id}`)}
							title={state.data.name}
							subtitle={`${count} ${t(count === 1 ? 'sites.one' : 'sites.other')}`}
							cover={covers[i] ?? null}
						/>
					);
				})
			}
		</div>

		<ImageLicense class="mt-6" />
	</main>
</Layout>

---
import Layout from "../../../../layouts/Layout.astro";
import { render, type CollectionEntry } from "astro:content";
import { getSitePaths, getSiteState, getSlug } from "../../../../i18n/content";
import { getLangFromUrl, useTranslatedPath } from "../../../../i18n/utils";
import { SEO } from "astro-seo";
import { TITLE_DELIMITER, SITE_TITLE } from "astro:env/client";

export function getStaticPaths() {
  return getSitePaths("en");
}

interface Props {
  site: CollectionEntry<"sites">;
}

const { site } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const state = await getSiteState(site, lang);
const { Content } = await render(site);
---

<Layout>
  <SEO
    slot="head"
    charset="utf-8"
    title={site.data.name}
    titleTemplate={`%s ${TITLE_DELIMITER} ${SITE_TITLE}`}
    description=""
    extend={{
      meta: [
        {
          name: "viewport",
          content: "width=device-width",
        },
        {
          name: "generator",
          content: Astro.generator,
        },
      ],
      link: [
        {
          rel: "icon",
          type: "image/svg+xml",
          href: "/favicon.svg",
        },
        {
          rel: "icon",
          href: "/favicon.ico",
        },
      ],
    }}
  />

  <a href={translatePath(`/zonas-arqueologicas/${getSlug(state)}`)}
    >{state.data.name}</a
  >

  <h1>{site.data.name}</h1>

  <Content />
</Layout>

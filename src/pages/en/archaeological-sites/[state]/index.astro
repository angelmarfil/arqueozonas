---
import Layout from '../../../../layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import PageHeader from '../../../../components/PageHeader.astro';
import ImageLicense from '../../../../components/ImageLicense.astro';
import SiteBadges from '../../../../components/SiteBadges.astro';
import VisitorCount from '../../../../components/VisitorCount.astro';
import LinkCard from '../../../../components/LinkCard.astro';
import { getStatePaths, getSiteCover, getSites, getSlug } from '../../../../i18n/content';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../../../i18n/utils';

export function getStaticPaths() {
	return getStatePaths();
}

interface Props {
	state: CollectionEntry<'states'>;
}

const { state } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const stateSlug = state.id;
const sites = await getSites(lang, stateSlug);
const covers = await Promise.all(sites.map(getSiteCover));
---

<Layout
	title={`${t('seo.sitesIn')} ${state.data.name}`}
	description={t('seo.sitesIn.description').replace('{state}', state.data.name)}
	image={covers.find(Boolean)}
>
	<main class="mx-auto w-full max-w-7xl px-4 py-6 sm:py-10 md:px-8">
		<PageHeader
			class="mb-6 sm:mb-8"
			title={state.data.name}
			crumbs={[
				{ label: t('nav.sites'), href: '/zonas-arqueologicas', icon: 'boxicons:pyramid-filled' },
				{ label: state.data.name, icon: 'boxicons:map' },
			]}
		>
			<p class="text-base-content/70">{`${sites.length} ${t(sites.length === 1 ? 'sites.one' : 'sites.other')}`}</p>
		</PageHeader>

		{sites.length > 0 ? (
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{sites.map((site, i) => (
					<LinkCard
						href={translatePath(`/zonas-arqueologicas/${stateSlug}/${getSlug(site)}`)}
						title={site.data.name}
						cover={covers[i] ?? null}
					>
						<VisitorCount place={site} />
						<SiteBadges site={site} />
					</LinkCard>
				))}
			</div>
		) : (
			<p class="text-base-content/60">{t('sites.empty')}</p>
		)}

		{covers.some(Boolean) && <ImageLicense class="mt-6" />}
	</main>
</Layout>

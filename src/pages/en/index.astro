---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import { SEO } from "astro-seo";
import { SITE_TITLE, TITLE_DELIMITER } from "astro:env/client";
import SitesMap from "../../components/SitesMap.astro";
import { getSites } from "../../i18n/content";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const sites = await getSites(lang);
---

<Layout>
  <SEO
    slot="head"
    charset="utf-8"
    titleDefault={SITE_TITLE}
    titleTemplate={`%s ${TITLE_DELIMITER} ${SITE_TITLE}`}
    extend={{
      meta: [
        {
          name: "viewport",
          content: "width=device-width",
        },
        {
          name: "generator",
          content: Astro.generator,
        },
      ],
      link: [
        {
          rel: "icon",
          type: "image/svg+xml",
          href: "/favicon.svg",
        },
        {
          rel: "icon",
          href: "/favicon.ico",
        },
      ],
    }}
  />

  <SitesMap sites={sites} class="mx-auto w-full max-w-7xl px-4 py-8 md:px-8" />
</Layout>

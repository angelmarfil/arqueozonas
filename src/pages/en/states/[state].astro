---
import Layout from '../../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getStatePaths, getSlug } from '../../../i18n/content';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
	return getStatePaths('en');
}

interface Props {
	state: CollectionEntry<'states'>;
}

const { state } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { Content } = await render(state);
---

<Layout>
	<a href={translatePath('/estados')}>{t('nav.states')}</a>

	<h1>{state.data.name}</h1>

	<Content />

	<a href={translatePath(`/zonas-arqueologicas/${getSlug(state)}`)}>{t('state.viewSites')}</a>
</Layout>

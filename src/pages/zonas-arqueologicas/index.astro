---
import Layout from "../../layouts/Layout.astro";
import { getStates } from "../../i18n/content";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../../i18n/utils";
import { SEO } from "astro-seo";
import { SITE_TITLE, TITLE_DELIMITER } from "astro:env/client";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const states = await getStates();
---

<Layout>
  <SEO
	slot="head"
	charset="utf-8"
    title="Zonas Arqueológicas"
    titleTemplate={`%s ${TITLE_DELIMITER} ${SITE_TITLE}`}
    description=""
    extend={{
      meta: [
        {
          name: "viewport",
          content: "width=device-width",
        },
        {
          name: "generator",
          content: Astro.generator,
        },
      ],
      link: [
        {
          rel: "icon",
          type: "image/svg+xml",
          href: "/favicon.svg",
        },
        {
          rel: "icon",
          href: "/favicon.ico",
        },
      ],
    }}
  />

  <h1>{t("nav.sites")}</h1>

  <ul>
    {
      states.map((state) => (
        <li>
          <a href={translatePath(`/zonas-arqueologicas/${state.id}`)}>
            {state.data.name}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

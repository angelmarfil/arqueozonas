---
import { Icon } from "astro-icon/components";
import { SEO } from "astro-seo";
import { SITE_TITLE, TITLE_DELIMITER } from "astro:env/client";
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "./PageHeader.astro";
import RelatedPlaces from "./RelatedPlaces.astro";
import SiteBadges from "./SiteBadges.astro";
import SiteGallery from "./SiteGallery.astro";
import ZoneMap from "./ZoneMap";
import { getSiteCover, getSiteGallery, getSiteMuseums, getSiteState, getSiteTours, getSlug } from "../i18n/content";
import { languages } from "../i18n/ui";
import { getLangFromUrl, getMapLabels, useTranslatedPath, useTranslations } from "../i18n/utils";

interface Props {
  site: CollectionEntry<"sites">;
}

interface SiteAction {
  label: string;
  icon: string;
  href: string;
  external?: boolean;
}

const { site } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const state = await getSiteState(site);
const gallery = await getSiteGallery(site);
const cover = await getSiteCover(site);
const { Content } = await render(site);
const statePath = `/zonas-arqueologicas/${state.id}`;
const formatDate = (date: Date) => date.toLocaleDateString(lang, { dateStyle: "long", timeZone: "UTC" });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);

const museums = await getSiteMuseums(site);
const relatedMuseums = await Promise.all(
  museums.map(async (museum) => ({
    href: translatePath(`/museos/${museum.data.state}/${getSlug(museum)}`),
    title: museum.data.name,
    cover: await getSiteCover(museum),
    entry: museum,
  })),
);

const { position, boundary } = site.data;
const actions: SiteAction[] = [];
const { guide } = site.data;
if (guide) {
  actions.push({
    label: guide === lang ? t("site.guide.download") : `${t("site.guide.download")} (${languages[guide]})`,
    icon: "boxicons:arrow-in-down-square-half",
    href: `/guides/${guide}/${getSlug(site)}.pdf`,
    external: true,
  });
}
const tours = await getSiteTours(site);
const groupTours = tours.length > 1;
if (tours.length === 1) {
  const [{ data }] = tours;
  actions.push({
    label: data.type === "site" ? t("site.tour") : data.name,
    icon: "boxicons:street-view",
    href: data.url,
    external: true,
  });
}
---

<Layout>
  <SEO
    slot="head"
    charset="utf-8"
    title={site.data.name}
    titleTemplate={`%s ${TITLE_DELIMITER} ${SITE_TITLE}`}
    extend={{
      meta: [
        {
          name: "viewport",
          content: "width=device-width",
        },
        {
          name: "generator",
          content: Astro.generator,
        },
        {
          name: "apple-mobile-web-app-title",
          content: "Arqueozonas MX",
        },
      ],
      link: [
        {
          rel: "icon",
          type: "image/png",
          href: "/favicon/favicon-96x96.png",
          sizes: "96x96",
        },
        {
          rel: "icon",
          type: "image/svg+xml",
          href: "/favicon/favicon.svg",
        },
        {
          rel: "shortcut icon",
          href: "/favicon/favicon.ico",
        },
        {
          rel: "apple-touch-icon",
          sizes: "180x180",
          href: "/favicon/apple-touch-icon.png",
        },
        {
          rel: "manifest",
          href: "/site.webmanifest",
        },
      ],
    }}
  />

  <main
    class="mx-auto flex w-full max-w-5xl flex-col gap-10 px-4 py-6 sm:gap-12 sm:py-10 md:px-8"
    data-pagefind-meta={cover && `image:${cover}`}
  >
    <PageHeader
      searchable
      title={site.data.name}
      crumbs={[
        { label: t("nav.sites"), href: "/zonas-arqueologicas", icon: "boxicons:pyramid-filled" },
        { label: state.data.name, href: statePath, icon: "boxicons:map" },
        { label: site.data.name },
      ]}
    >
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-base-content/70">
        <SiteBadges site={site} size="md" />
        <a href={translatePath(statePath)} class="link link-hover inline-flex items-center gap-1.5">
          <Icon name="boxicons:map" class="size-4" aria-hidden="true" />
          {state.data.name}
        </a>
        {
          site.data.lastReviewed && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="boxicons:calendar" class="size-4" aria-hidden="true" />
              {t("site.lastReviewed")}:
              <time datetime={isoDate(site.data.lastReviewed)}>{formatDate(site.data.lastReviewed)}</time>
            </span>
          )
        }
      </div>
      {
        (actions.length > 0 || groupTours) && (
          <Fragment slot="actions">
            {actions.map(({ label, icon, href, external }) => (
              <a
                href={href}
                class="btn"
                {...(external && { target: "_blank", rel: "noopener" })}
              >
                <Icon name={icon} class="size-5" is:inline aria-hidden="true" />
                {label}
              </a>
            ))}
            {groupTours && (
              <div class="dropdown md:dropdown-end">
                <div tabindex="0" role="button" class="btn">
                  <Icon name="boxicons:street-view" class="size-5" aria-hidden="true" />
                  {t("site.tours")}
                  <Icon name="boxicons:chevron-down" class="size-3 opacity-60" aria-hidden="true" />
                </div>
                <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-5 mt-2 w-72 p-2 shadow-sm">
                  {tours.map(({ data }) => (
                    <li>
                      <a href={data.url} target="_blank" rel="noopener">
                        {data.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </Fragment>
        )
      }
    </PageHeader>

    {gallery && <SiteGallery gallery={gallery} />}

    <article class="flex flex-col gap-4">
      <Content />
      <footer class="flex flex-col gap-1 text-xs text-base-content/60">
        {
          site.data.inahId && (
            <p>
              {t("site.source.text")}{" "}
              <a
                href={`https://creativecommons.org/licenses/by-nc-nd/4.0/deed.${lang}`}
                target="_blank"
                rel="noopener license"
                class="link"
              >
                CC BY-NC-ND 4.0
              </a>. {t("site.source.unmodified")}{" · "}
              <a
                href={`https://lugares.inah.gob.mx/${lang}/node/${site.data.inahId}`}
                target="_blank"
                rel="noopener"
                class="link"
              >
                {t("site.source.lugares")}
              </a>
            </p>
          )
        }
      </footer>
    </article>

    <RelatedPlaces title={t("site.museums")} icon="boxicons:bank-filled" places={relatedMuseums} />

    {
      position && (
        <section class="flex flex-col gap-4">
          <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
            <Icon name="boxicons:location" class="size-6 shrink-0 text-base-content/50" aria-hidden="true" />
            {t("site.map")}
          </h2>
          <ZoneMap client:visible kind="site" name={site.data.name} position={position} boundary={boundary} labels={getMapLabels(t)} />
        </section>
      )
    }
  </main>
</Layout>

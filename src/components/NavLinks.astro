---
import { Icon } from "astro-icon/components";
import type { UIKey } from "../i18n/ui";
import {
  getLangFromUrl,
  getRouteFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const route = getRouteFromUrl(Astro.url);

const navItems: { label: UIKey; icon: string; href?: string }[] = [
  {
    label: "nav.sites",
    icon: "boxicons:pyramid-filled",
    href: "/zonas-arqueologicas",
  },
  { label: "nav.museums", icon: "boxicons:bank-filled" },
];

const isActive = (href: string) =>
  route === href || route.startsWith(`${href}/`);
---

{
  navItems.map(({ label, icon, href }) =>
    href ? (
      <li>
        <a
          href={translatePath(href)}
          class:list={{ "menu-active": isActive(href) }}
          aria-current={isActive(href) ? "page" : undefined}
        >
          <Icon name={icon} class="size-5" aria-hidden="true" />
          {t(label)}
        </a>
      </li>
    ) : (
      <li class="menu-disabled">
        <span>
          <Icon name={icon} class="size-5" aria-hidden="true" />
          {t(label)}
        </span>
      </li>
    ),
  )
}

---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import LinkCard from "./LinkCard.astro";
import VisitorCount from "./VisitorCount.astro";

interface Place {
  href: string;
  title: string;
  subtitle?: string;
  cover?: string | null;
  entry?: CollectionEntry<"sites"> | CollectionEntry<"museums">;
}

interface Props {
  title: string;
  icon: string;
  places: Place[];
}

const { title, icon, places } = Astro.props;
---

{
  places.length > 0 && (
    <section class="flex flex-col gap-4">
      <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
        <Icon name={icon} class="size-6 shrink-0 text-base-content/50" aria-hidden="true" />
        {title}
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {places.map(({ href, title, subtitle, cover, entry }) => (
          <LinkCard href={href} title={title} subtitle={subtitle} cover={cover ?? null}>
            {entry && <VisitorCount place={entry} />}
          </LinkCard>
        ))}
      </div>
    </section>
  )
}

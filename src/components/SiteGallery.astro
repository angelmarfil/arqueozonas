---
import type { CollectionEntry } from "astro:content";
import ImageLicense from "./ImageLicense.astro";
import InlineGallery, { type Slide } from "./InlineGallery";
import { getImageUrl } from "../i18n/content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  gallery: CollectionEntry<"galleries">;
}

const { gallery } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slides: Slide[] = gallery.data.images.map(({ key, title, credit }) => ({
  src: getImageUrl(key, 1600),
  thumb: getImageUrl(key, 240),
  downloadUrl: getImageUrl(key),
  alt: title,
  credit: credit && `${t("site.gallery.credit")}: ${credit}`,
}));
---

<section>
  <InlineGallery client:load slides={slides} />
  <ImageLicense class="mt-2">
    {" · "}
    <a
      href={`https://lugares.inah.gob.mx/${lang}/node/${gallery.data.inahId}`}
      target="_blank"
      rel="noopener"
      class="link"
    >
      {t("site.source.lugares")}
    </a>
  </ImageLicense>
</section>

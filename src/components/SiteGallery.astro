---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageLicense from "./ImageLicense.astro";
import InlineGallery, { type Slide } from "./InlineGallery";
import { getImageUrl } from "../i18n/content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  gallery: CollectionEntry<"galleries">;
}

const { gallery } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slides: Slide[] = gallery.data.images.map(({ key, title, credit }) => ({
  src: getImageUrl(key, 1600),
  thumb: getImageUrl(key, 240),
  downloadUrl: getImageUrl(key),
  alt: title,
  credit: credit && `${t("site.gallery.credit")}: ${credit}`,
}));

const strings = {
  galleryLabel: t("gallery.galleryLabel"),
  slideAnnouncement: t("gallery.slideAnnouncement"),
  previousSlide: t("gallery.previousSlide"),
  nextSlide: t("gallery.nextSlide"),
  toggleMaximize: t("gallery.toggleMaximize"),
  moreOptions: t("gallery.moreOptions"),
  download: t("gallery.download"),
  zoomIn: t("gallery.zoomIn"),
  zoomOut: t("gallery.zoomOut"),
  viewActualSize: t("gallery.viewActualSize"),
  toggleAutoplay: t("gallery.toggleAutoplay"),
  toggleThumbnails: t("gallery.toggleThumbnails"),
  closeGallery: t("gallery.closeGallery"),
  mediaLoadingFailed: t("gallery.mediaLoadingFailed"),
};
---

<section>
  <InlineGallery client:load slides={slides} strings={strings}>
    <Icon slot="prev" name="boxicons:chevron-left" is:inline aria-hidden="true" />
    <Icon slot="next" name="boxicons:chevron-right" is:inline aria-hidden="true" />
    <Icon slot="download" name="boxicons:arrow-in-down-square-half" is:inline aria-hidden="true" />
    <Icon slot="maximize" name="boxicons:maximize" is:inline aria-hidden="true" />
    <Icon slot="minimize" name="boxicons:minimize" is:inline aria-hidden="true" />
    <Icon slot="zoomIn" name="boxicons:search-plus" is:inline aria-hidden="true" />
    <Icon slot="zoomOut" name="boxicons:search-minus" is:inline aria-hidden="true" />
    <Icon slot="actualSize" name="boxicons:scale" is:inline aria-hidden="true" />
    <Icon slot="autoplayPlay" name="boxicons:play" is:inline aria-hidden="true" />
    <Icon slot="autoplayPause" name="boxicons:pause" is:inline aria-hidden="true" />
    <Icon slot="more" name="boxicons:dots-horizontal-rounded" is:inline aria-hidden="true" />
  </InlineGallery>
  <ImageLicense class="mt-2">
    {" · "}
    <a
      href={`https://lugares.inah.gob.mx/${lang}/node/${gallery.data.inahId}`}
      target="_blank"
      rel="noopener"
      class="link"
    >
      {t("site.source.lugares")}
    </a>
  </ImageLicense>
</section>

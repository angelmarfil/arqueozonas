---
import type { CollectionEntry } from "astro:content";
import { GOOGLE_MAPS_API_KEY } from "astro:env/client";
import { Icon } from "astro-icon/components";
import ClusteredMap, { type MapSite } from "./ClusteredMap";
import { getSiteCover, getSlug } from "../i18n/content";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "../i18n/utils";

interface Props {
  sites: CollectionEntry<"sites">[];
  class?: string;
}

const { sites, class: className } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const mapSites: MapSite[] = await Promise.all(
  sites
    .filter((site) => site.data.position)
    .map(async (site) => ({
      id: site.id,
      name: site.data.name,
      href: translatePath(`/zonas-arqueologicas/${site.data.state}/${getSlug(site)}`),
      position: site.data.position!,
      cover: await getSiteCover(site),
      isOpen: site.data.isOpen,
    })),
);
---

{
  GOOGLE_MAPS_API_KEY && mapSites.length > 0 && (
    <section class={className}>
      <ClusteredMap
        client:visible
        sites={mapSites}
        lang={lang}
        labels={{
          open: t("site.status.open"),
          closed: t("site.status.closed"),
          details: t("map.details"),
          close: t("map.close"),
        }}
      >
        <Icon slot="closeIcon" name="boxicons:x" class="size-5" is:inline aria-hidden="true" />
      </ClusteredMap>
    </section>
  )
}

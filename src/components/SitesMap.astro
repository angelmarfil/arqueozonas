---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import ClusteredMap, { type MapSite, type MapStation } from "./ClusteredMap";
import trainRoute from "../data/maya-train.json";
import { getMuseums, getPlaceVisitors, getSiteCover, getSlug, getStates, getStationLogo, getStationSections, getStations } from "../i18n/content";
import { formatVisitorCount, getLangFromUrl, getMapLabels, useTranslatedPath, useTranslations } from "../i18n/utils";

interface Props {
  sites: CollectionEntry<"sites">[];
  museums?: CollectionEntry<"museums">[];
  class?: string;
}

const { sites, class: className } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const museums = Astro.props.museums ?? (await getMuseums(lang));
const states = new Map((await getStates()).map(({ id, data }) => [id, data.name]));

async function details(place: CollectionEntry<"sites"> | CollectionEntry<"museums">) {
  const visitors = await getPlaceVisitors(place);
  return {
    name: place.data.name,
    state: states.get(place.data.state) ?? place.data.state,
    position: place.data.position!,
    cover: await getSiteCover(place),
    visitors: visitors && formatVisitorCount(lang, visitors),
  };
}

const mapSites: MapSite[] = await Promise.all([
  ...sites
    .filter((site) => site.data.position)
    .map(async (site) => ({
      ...(await details(site)),
      id: `site:${site.id}`,
      kind: "site" as const,
      href: translatePath(`/zonas-arqueologicas/${site.data.state}/${getSlug(site)}`),
      isOpen: site.data.isOpen,
      hasMayaTrain: site.data.hasMayaTrain,
    })),
  ...museums
    .filter((museum) => museum.data.position)
    .map(async (museum) => ({
      ...(await details(museum)),
      id: `museum:${museum.id}`,
      kind: "museum" as const,
      href: translatePath(`/museos/${museum.data.state}/${getSlug(museum)}`),
      type: museum.data.type && t(`museum.type.${museum.data.type}`),
    })),
]);

const sections = new Map((await getStationSections()).map(({ id, data }) => [id, data]));
const mapStations: MapStation[] = await Promise.all((await getStations()).map(async (station) => ({
  id: `station:${station.id}`,
  name: t("mayaTrain.station").replace("{name}", station.data.name),
  state: states.get(station.data.state) ?? station.data.state,
  href: translatePath(`/tren-maya/${station.id}`),
  position: station.data.position,
  logo: (await getImage({ src: getStationLogo(station), width: 112 })).src,
  section: t("mayaTrain.section").replace("{number}", station.data.section.id),
  color: sections.get(station.data.section.id)!.color,
})));
---

{
  mapSites.length > 0 && (
    <div class={className}>
      <ClusteredMap
        client:visible
        sites={mapSites}
        stations={mapStations}
        trainRoute={trainRoute}
        labels={getMapLabels(t)}
      />
    </div>
  )
}

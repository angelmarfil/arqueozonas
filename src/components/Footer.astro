---
import { SITE_TITLE } from "astro:env/client";
import LogoVertical from "../assets/brand/logo-vertical.svg";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const year = new Date().getFullYear();
---

<footer class="bg-base-200 text-base-content mt-auto" transition:animate="none">
  <div class="flex flex-col items-center gap-4 p-10 text-center md:px-16">
    <a href={translatePath("/")} aria-label={SITE_TITLE}>
      <LogoVertical class="h-24 w-auto" aria-hidden="true" />
    </a>
    <p class="text-base-content/70">{t("home.title")}</p>
  </div>
  <div class="border-base-300 text-base-content/70 flex flex-col items-center gap-4 border-t px-10 py-6 text-center text-sm md:px-16">
    <p>
      <span class="block">{t("footer.disclaimer.1")}</span>
      <span class="block">{t("footer.disclaimer.2")}</span>
      <span class="block">{t("footer.disclaimer.3")}</span>
    </p>
    <p>© {year} <a href="https://github.com/angelmarfil" target="_blank" rel="noopener" class="link link-hover">Angel Marfil</a></p>
  </div>
</footer>

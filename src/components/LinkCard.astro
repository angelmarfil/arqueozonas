---
import { Icon } from "astro-icon/components";
import { getTransitionName } from "../lib/view-transitions";

interface Props {
	href: string;
	title: string;
	subtitle?: string;
	/** Remote cover image URL; `null` renders an empty placeholder so cards stay aligned. */
	cover?: string | null;
}

const { href, title, subtitle, cover } = Astro.props;
---

<a
	href={href}
	class="card card-border bg-base-100 transition-colors hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content"
>
	{cover !== undefined && (
		<figure class="relative aspect-4/3 bg-base-200">
			<Icon name="boxicons:image-landscape" class="size-12 text-base-content/25" aria-hidden="true" />
			{cover && (
				<img
					src={cover}
					alt=""
					loading="lazy"
					decoding="async"
					onerror="this.hidden = true"
					class="absolute inset-0 h-full w-full object-cover"
				/>
			)}
		</figure>
	)}
	<div class="card-body">
		<h2 class="card-title" transition:name={getTransitionName(href)}>{title}</h2>
		{subtitle && <p class="text-base-content/70">{subtitle}</p>}
		<slot />
	</div>
</a>

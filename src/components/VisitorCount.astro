---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { getPlaceVisitors } from "../i18n/content";
import { formatVisitorCount, getLangFromUrl } from "../i18n/utils";

interface Props {
  place: CollectionEntry<"sites"> | CollectionEntry<"museums">;
}

const { place } = Astro.props;
const visitors = await getPlaceVisitors(place);
---

{
  visitors && (
    <p class="flex items-center gap-1.5 text-sm text-base-content/70">
      <Icon name="boxicons:group" class="size-4 shrink-0 text-base-content/50" aria-hidden="true" />
      {formatVisitorCount(getLangFromUrl(Astro.url), visitors)}
    </p>
  )
}

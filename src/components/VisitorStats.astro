---
import { Icon } from "astro-icon/components";
import VisitorPanel from "./VisitorPanel.astro";
import { getVisitorYears } from "../i18n/content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const tabs = [
  { kind: "sites", label: t("nav.sites"), icon: "boxicons:pyramid-filled", years: await getVisitorYears("siteVisitors") },
  { kind: "museums", label: t("nav.museums"), icon: "boxicons:bank-filled", years: await getVisitorYears("museumVisitors") },
] as const;
const available = tabs.filter(({ years }) => years.length > 0);
---

{
  available.length > 0 && (
    <section data-visitor-stats class:list={["flex flex-col gap-4", className]}>
      <div class="flex flex-col gap-1">
        <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
          <Icon name="boxicons:bar-chart-big" class="size-6 shrink-0 text-base-content/50" aria-hidden="true" />
          {t("visitors.title")}
        </h2>
        <p class="max-w-3xl text-base-content/70">{t("visitors.description")}</p>
      </div>

      <div class="tabs tabs-lift">
        {available.map(({ kind, label, icon }, i) => (
          <>
            <label class="tab gap-2">
              <input type="radio" name="visitor-stats" checked={i === 0} />
              <Icon name={icon} class="size-4" aria-hidden="true" />
              {label}
            </label>
            <div class="tab-content border-base-300 bg-base-100 p-4 sm:p-6">
              <VisitorPanel kind={kind} />
            </div>
          </>
        ))}
      </div>
    </section>
  )
}

<script>
  import type { Chart as ChartType } from "chart.js";

  interface ChartInput {
    years: number[];
    national: number[];
    foreign: number[];
    labels: { national: string; foreign: string; total: string };
    locale: string;
  }

  async function renderCharts(section: HTMLElement) {
    const { BarController, BarElement, CategoryScale, Chart, Legend, LinearScale, Tooltip } = await import("chart.js");
    Chart.register(BarController, BarElement, CategoryScale, LinearScale, Legend, Tooltip);
    const canvases = [...section.querySelectorAll<HTMLCanvasElement>("canvas[data-visitor-chart]")];
    let charts: ChartType[] = [];

    const draw = () => {
      charts.forEach((chart) => chart.destroy());
      const style = getComputedStyle(section);
      const color = (name: string) => style.getPropertyValue(`--color-${name}`);
      Chart.defaults.font.family = style.fontFamily;
      Chart.defaults.color = color("base-content");

      charts = canvases.map((canvas) => {
        const { years, national, foreign, labels, locale }: ChartInput = JSON.parse(canvas.dataset.visitorChart ?? "{}");
        const formatNumber = new Intl.NumberFormat(locale).format;
        const formatCompact = new Intl.NumberFormat(locale, { notation: "compact" }).format;
        const bar = { borderSkipped: "bottom", maxBarThickness: 24 } as const;

        return new Chart(canvas, {
          type: "bar",
          data: {
            labels: years.map(String),
            datasets: [
              { ...bar, label: labels.national, data: national, backgroundColor: color("primary"), borderColor: color("base-100"), borderWidth: { top: 2 } },
              { ...bar, label: labels.foreign, data: foreign, backgroundColor: color("secondary"), borderRadius: { topLeft: 4, topRight: 4 } },
            ],
          },
          options: {
            maintainAspectRatio: false,
            animation: false,
            interaction: { mode: "index", intersect: false },
            scales: {
              x: { stacked: true, grid: { display: false }, border: { color: color("base-300") }, ticks: { maxRotation: 0, autoSkipPadding: 12 } },
              y: { stacked: true, border: { display: false }, grid: { color: color("base-300") }, ticks: { callback: (value) => formatCompact(Number(value)) } },
            },
            plugins: {
              legend: { align: "start", labels: { boxWidth: 12, boxHeight: 12, useBorderRadius: true, borderRadius: 2 } },
              tooltip: {
                callbacks: {
                  label: ({ dataset, parsed }) => `${dataset.label}: ${formatNumber(parsed.y ?? 0)}`,
                  footer: (items) => `${labels.total}: ${formatNumber(items.reduce((sum, { parsed }) => sum + (parsed.y ?? 0), 0))}`,
                },
              },
            },
          },
        });
      });
    };

    draw();
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
  }

  for (const section of document.querySelectorAll<HTMLElement>("[data-visitor-stats]")) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some(({ isIntersecting }) => isIntersecting)) return;
        observer.disconnect();
        renderCharts(section);
      },
      { rootMargin: "200px" },
    );
    observer.observe(section);
  }
</script>

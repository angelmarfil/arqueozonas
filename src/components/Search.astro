---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import "../styles/pagefind.css";
---

<PagefindConfig />
<pagefind-modal-trigger></pagefind-modal-trigger>
<pagefind-modal reset-on-close>
  <pagefind-modal-header>
    <pagefind-input></pagefind-input>
  </pagefind-modal-header>
  <pagefind-modal-body>
    <pagefind-summary></pagefind-summary>
    <pagefind-results show-images></pagefind-results>
  </pagefind-modal-body>
  <pagefind-modal-footer>
    <pagefind-keyboard-hints></pagefind-keyboard-hints>
  </pagefind-modal-footer>
</pagefind-modal>

<script>
  import { getInstanceManager } from "@pagefind/component-ui";

  document.addEventListener("astro:before-swap", () => {
    const manager = getInstanceManager();
    manager.getInstanceNames().forEach((name) => manager.removeInstance(name));
  });
</script>

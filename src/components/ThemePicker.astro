---
import { Icon } from 'astro-icon/components';
import themes from 'daisyui/functions/themeOrder';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  name: string;
}

const { name } = Astro.props;
const themeList = ['arqueozonas', 'arqueozonas-dark', ...themes];
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="dropdown dropdown-end">
  <div
    tabindex="0"
    role="button"
    class="btn btn-ghost gap-1.5 px-1.5"
    aria-label={t('themePicker.label')}
  >
    <div class="bg-base-100 border-base-content/10 grid shrink-0 grid-cols-2 gap-0.5 rounded-md border p-1" aria-hidden="true">
      <div class="bg-base-content size-1 rounded-full"></div>
      <div class="bg-primary size-1 rounded-full"></div>
      <div class="bg-secondary size-1 rounded-full"></div>
      <div class="bg-accent size-1 rounded-full"></div>
    </div>
    <Icon name="boxicons:chevron-down" class="size-3 opacity-60" aria-hidden="true" />
  </div>
  <div
    tabindex="-1"
    class="dropdown-content bg-base-200 text-base-content rounded-box z-1 mt-2 max-h-[calc(100vh-8.6rem)] w-56 overflow-y-auto border border-white/5 shadow-2xl outline-1 outline-black/5"
  >
    <ul class="menu w-full">
      <li class="menu-title text-xs">{t('themePicker.label')}</li>
      {themeList.map((theme) => (
        <li>
          <label class="group gap-3 px-2">
            <input type="radio" name={name} value={theme} class="theme-controller sr-only" />
            <div data-theme={theme} class="bg-base-100 grid shrink-0 grid-cols-2 gap-0.5 rounded-md p-1 shadow-sm">
              <div class="bg-base-content size-1 rounded-full"></div>
              <div class="bg-primary size-1 rounded-full"></div>
              <div class="bg-secondary size-1 rounded-full"></div>
              <div class="bg-accent size-1 rounded-full"></div>
            </div>
            <div class="w-32 truncate">{theme}</div>
            <Icon name="boxicons:check" class="invisible size-3 shrink-0 group-has-checked:visible" aria-hidden="true" />
          </label>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  const getControllers = () => document.querySelectorAll<HTMLInputElement>('.theme-controller');

  const applyTheme = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    getControllers().forEach((input) => {
      input.checked = input.value === theme;
    });
  };

  document.addEventListener('astro:before-swap', ({ newDocument }) => {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) newDocument.documentElement.dataset.theme = savedTheme;
  });

  document.addEventListener('astro:page-load', () => {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) applyTheme(savedTheme);

    getControllers().forEach((input) => {
      input.addEventListener('change', () => {
        localStorage.setItem('theme', input.value);
        applyTheme(input.value);
      });
    });
  });
</script>

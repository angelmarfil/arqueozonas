---
import { Icon } from 'astro-icon/components';
import themes from '../data/themes.json';
import type { UIKey } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  name: string;
  block?: boolean;
}

const { name, block = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class:list={['dropdown', block ? 'w-full' : 'dropdown-end']}>
  <div
    tabindex="0"
    role="button"
    class:list={['btn btn-sm', block ? 'w-full justify-start' : 'max-lg:btn-square']}
    aria-label={t('themePicker.label')}
  >
    <Icon name="boxicons:palette" class="size-4" aria-hidden="true" />
    <span class:list={{ 'hidden lg:inline': !block }}>{t('themePicker.label')}</span>
    {block && <Icon name="boxicons:chevron-down" class="ms-auto size-4 opacity-60" aria-hidden="true" />}
  </div>
  <ul tabindex="-1" role="radiogroup" aria-label={t('themePicker.label')} class:list={['dropdown-content menu bg-base-100 rounded-box z-1 mt-1 gap-1 p-2 shadow-sm', block ? 'w-full' : 'w-60']}>
    {themes.map((theme) => (
      <li role="none">
        <label class="group">
          <input type="radio" name={name} value={theme} class="theme-controller sr-only" />
          <div data-theme={theme} class="bg-base-100 grid shrink-0 grid-cols-2 gap-0.5 rounded-md p-1 shadow-sm" aria-hidden="true">
            <div class="bg-base-content size-1 rounded-full"></div>
            <div class="bg-primary size-1 rounded-full"></div>
            <div class="bg-secondary size-1 rounded-full"></div>
            <div class="bg-accent size-1 rounded-full"></div>
          </div>
          <span class="flex-1 truncate">{t(`theme.${theme}` as UIKey)}</span>
          <Icon name="boxicons:check" class="invisible size-4 shrink-0 group-has-checked:visible" aria-hidden="true" />
        </label>
      </li>
    ))}
  </ul>
</div>

<script>
  const getControllers = () => document.querySelectorAll<HTMLInputElement>('.theme-controller');

  const applyTheme = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    getControllers().forEach((input) => {
      input.checked = input.value === theme;
    });
  };

  document.addEventListener('astro:before-swap', ({ newDocument }) => {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) newDocument.documentElement.dataset.theme = savedTheme;
  });

  document.addEventListener('astro:page-load', () => {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) applyTheme(savedTheme);

    getControllers().forEach((input) => {
      input.addEventListener('change', () => {
        localStorage.setItem('theme', input.value);
        applyTheme(input.value);
      });
    });
  });
</script>
